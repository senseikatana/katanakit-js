
# AI assistant (DashScope / OpenAI-compatible)
DASHSCOPE_API_KEY="sk-"
PORT="3000"
HOST="localhost"
KITT_CHANNEL="rest"

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=""

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Cloudflare API token (dashboard > Profile > API Tokens > Create Token).
# Leave empty locally to use the `wrangler login` OAuth session; a non-empty
# value (even a placeholder) overrides it and breaks wrangler.
# Required for scripts/setup-cloudflare.mjs and the CI secret CLOUDFLARE_API_TOKEN.
CLOUDFLARE_API_TOKEN=""
# Cloudflare dashboard > Account Home > Account ID
CLOUDFLARE_ACCOUNT_ID=""
