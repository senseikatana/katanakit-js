{
	"name": "katanakit-js",
	"version": "6.3.1",
	"description": "KatanaKit — a sharp, framework-agnostic TypeScript service toolkit organized with hexagonal architecture.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./adapters/express": {
			"types": "./dist/adapters/express/index.d.ts",
			"import": "./dist/adapters/express/index.js",
			"default": "./dist/adapters/express/index.js"
		},
		"./adapters/bun": {
			"types": "./dist/adapters/bun/index.d.ts",
			"import": "./dist/adapters/bun/index.js",
			"default": "./dist/adapters/bun/index.js"
		},
		"./adapters/nuxt": {
			"types": "./dist/adapters/nuxt/index.d.ts",
			"import": "./dist/adapters/nuxt/index.js",
			"default": "./dist/adapters/nuxt/index.js"
		},
		"./adapters/vue": {
			"types": "./dist/adapters/vue/index.d.ts",
			"import": "./dist/adapters/vue/index.js",
			"default": "./dist/adapters/vue/index.js"
		},
		"./adapters/astro": {
			"types": "./dist/adapters/astro/index.d.ts",
			"import": "./dist/adapters/astro/index.js",
			"default": "./dist/adapters/astro/index.js"
		},
		"./adapters/photoswipe": {
			"types": "./dist/adapters/photoswipe/index.d.ts",
			"import": "./dist/adapters/photoswipe/index.js",
			"default": "./dist/adapters/photoswipe/index.js"
		},
		"./adapters/assistant": {
			"types": "./dist/adapters/assistant/index.d.ts",
			"import": "./dist/adapters/assistant/index.js",
			"default": "./dist/adapters/assistant/index.js"
		},
		"./adapters/telegram": {
			"types": "./dist/adapters/telegram/index.d.ts",
			"import": "./dist/adapters/telegram/index.js",
			"default": "./dist/adapters/telegram/index.js"
		},
		"./adapters/whatsapp": {
			"types": "./dist/adapters/whatsapp/index.d.ts",
			"import": "./dist/adapters/whatsapp/index.js",
			"default": "./dist/adapters/whatsapp/index.js"
		},
		"./adapters/notion": {
			"types": "./dist/adapters/notion/index.d.ts",
			"import": "./dist/adapters/notion/index.js",
			"default": "./dist/adapters/notion/index.js"
		},
		"./adapters/wordpress": {
			"types": "./dist/adapters/wordpress/index.d.ts",
			"import": "./dist/adapters/wordpress/index.js",
			"default": "./dist/adapters/wordpress/index.js"
		},
		"./adapters/react": {
			"types": "./dist/adapters/react/index.d.ts",
			"import": "./dist/adapters/react/index.js",
			"default": "./dist/adapters/react/index.js"
		},
		"./adapters/solid": {
			"types": "./dist/adapters/solid/index.d.ts",
			"import": "./dist/adapters/solid/index.js",
			"default": "./dist/adapters/solid/index.js"
		},
		"./adapters/svelte": {
			"types": "./dist/adapters/svelte/index.d.ts",
			"import": "./dist/adapters/svelte/index.js",
			"default": "./dist/adapters/svelte/index.js"
		},
		"./adapters/angular": {
			"types": "./dist/adapters/angular/index.d.ts",
			"import": "./dist/adapters/angular/index.js",
			"default": "./dist/adapters/angular/index.js"
		},
		"./adapters/vanilla": {
			"types": "./dist/adapters/vanilla/index.d.ts",
			"import": "./dist/adapters/vanilla/index.js",
			"default": "./dist/adapters/vanilla/index.js"
		},
		"./adapters/insforge": {
			"types": "./dist/adapters/insforge/index.d.ts",
			"import": "./dist/adapters/insforge/index.js",
			"default": "./dist/adapters/insforge/index.js"
		},
		"./prisma": {
			"types": "./dist/prisma/index.d.ts",
			"import": "./dist/prisma/index.js",
			"default": "./dist/prisma/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.js",
			"default": "./dist/schemas/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22.18.0"
	},
	"workspaces": [
		"packages/ui"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "husky",
		"predev": "bunx lint-staged",
		"dev": "concurrently --names api,assistant,tg,wa \"bun run dev:api\" \"bun run assistant:dev\" \"bun run telegram:dev\" \"bun run whatsapp:dev\"",
		"postdev": "bun run lint",
		"dev:api": "tsx src/adapters/express/main.ts",
		"bun:dev": "bun run src/adapters/bun/main.ts",
		"assistant:dev": "tsx src/adapters/assistant/main.ts",
		"telegram:dev": "tsx src/adapters/telegram/main.ts",
		"whatsapp:dev": "tsx src/adapters/whatsapp/main.ts",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"lint": "eslint ./src packages/ui/src",
		"lint:fix": "eslint --fix ./src packages/ui/src",
		"lint:staged": "lint-staged",
		"check": "eslint ./src packages/ui/src && tsc6 --noEmit && tsc6 -p packages/ui/tsconfig.json --noEmit && vitest run",
		"examples:check": "tsc6 -p tsconfig.examples.json && tsc6 -p tsconfig.examples.solid.json",
		"fix": "eslint --fix ./src packages/ui/src && tsc6 --noEmit && vitest run",
		"prebuild": "bunx lint-staged",
		"build": "bun run clean && bun run check && tsc6 -p tsconfig.json && node scripts/generate-release-notes.mjs --sync-versions",
		"postbuild": "bun run examples:check",
		"release": "bun run build && node scripts/generate-release-notes.mjs \"v$(node -p \"require('./package.json').version\")\" --write && npm publish --access public",
		"ui:build": "bun run --filter @katanakit/ui build",
		"docs:clean": "node scripts/docs.mjs clean",
		"docs:prepare": "node scripts/docs-prepare.mjs",
		"docs:dev": "node scripts/docs.mjs dev",
		"predocs": "bunx lint-staged",
		"docs": "node scripts/docs.mjs build",
		"postdocs": "node -e \"require('node:fs').accessSync('docs/.vitepress/dist/index.html')\"",
		"docs:preview": "vitepress preview docs",
		"docs:gh": "node scripts/docs.mjs gh",
		"cf:deploy": "bun run build && bun run docs && wrangler pages deploy docs/.vitepress/dist --project-name katanakit-docs --branch main"
	},
	"lint-staged": {
		"**/*.{ts,tsx}": "eslint --fix --quiet"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/senseikatana/katanakit-js.git"
	},
	"keywords": [
		"api",
		"fetch",
		"http-client",
		"url-builder",
		"typescript",
		"hexagonal-architecture",
		"astro",
		"express",
		"nuxt",
		"vue",
		"react",
		"solid",
		"svelte",
		"angular",
		"singleton",
		"observer",
		"factory",
		"notion",
		"wordpress"
	],
	"author": "senseikatana - Sergio Jurado",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/senseikatana/katanakit-js/issues"
	},
	"unpkg": "./dist/index.js",
	"jsdelivr": "./dist/index.js",
	"dependencies": {
		"@js-temporal/polyfill": "0.5.1",
		"@prisma/orm-postgres": "8.0.0-rc.8",
		"@tanstack/query-core": "5.103.2",
		"express-rate-limit": "8.7.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@angular/core": ">=16.0.0",
		"@faker-js/faker": ">=9.0.0",
		"@insforge/sdk": ">=1.5.0",
		"cors": ">=2.8.0",
		"dotenv": ">=16.0.0",
		"express": ">=5.0.0",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0",
		"solid-js": ">=1.7.0",
		"svelte": ">=3.0.0",
		"vue": ">=3.0.0",
