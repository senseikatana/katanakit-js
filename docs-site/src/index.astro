---
import StarlightPage from '@astrojs/starlight/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'KatanaKit', template: 'splash' }}>
	<div class="hero">
		<h1>KatanaKit</h1>
		<p>A sharp, framework-agnostic TypeScript service toolkit organized with hexagonal architecture.</p>
		<div class="actions">
			<a href="/katanakit-js/guides/getting-started/" class="sl-button primary">Get Started</a>
			<a href="/katanakit-js/api/" class="sl-button secondary">API Reference</a>
		</div>
	</div>

	<div class="features">
		<div class="feature">
			<h3>Framework Agnostic</h3>
			<p>Works with Astro, Nuxt, Express, Vue and more. No vendor lock-in.</p>
		</div>
		<div class="feature">
			<h3>Hexagonal Architecture</h3>
			<p>Clean separation of concerns with ports and adapters pattern.</p>
		</div>
		<div class="feature">
			<h3>Type Safe</h3>
			<p>Full TypeScript support with auto-generated API documentation.</p>
		</div>
	</div>
</StarlightPage>

<style>
	.hero {
		text-align: center;
		padding: 4rem 2rem;
	}
	.hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
	}
	.hero p {
		font-size: 1.25rem;
		color: var(--sl-color-gray-2);
		margin-bottom: 2rem;
	}
	.actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}
	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		padding: 2rem;
	}
	.feature {
		padding: 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}
	.feature h3 {
		margin-bottom: 0.5rem;
	}
</style>
