	"narrative": {
		"northStar": "The Technical Workshop",
		"overview": "KatanaKit is a practical, modular toolkit. Its visual language prioritizes readable interfaces, explicit semantic states, and reusable scales over decorative treatment. The source SCSS palette is the design-token authority for the UI package; the documentation site inherits its separate light and dark surfaces from VitePress. The amber and orange families are established palette options, not new runtime tokens: both already exist in scss/_variables.scss. This document makes their full scales visible in OKLCH alongside every other source palette. Values are converted from the existing HSL/HSLA source for documentation; the Sass source remains unchanged and authoritative for rendered colors.",
		"keyCharacteristics": [
			"Semantic, named color families with eleven shades (50–950).",
			"A compact UI kit built from purple primary actions, neutral surfaces, and clear status colors.",
			"Independent documentation-site colors with light and dark theme variants."
		],
		"rules": [
			{
				"name": "The Source-Of-Truth Rule",
				"body": "Use Sass tokens in scss/_variables.scss for framework colors; OKLCH values here are a readable, converted representation, not a replacement source of truth.",
				"section": "colors"
			},
