---
/**
 * Slot override for `SocialIcons`: the default social links plus the
 * GitHub stars pill and the releases flyout (the VitePress
 * `nav-bar-content-after` slot).
 */
import DefaultSocialIcons from "@astrojs/starlight/components/SocialIcons.astro";

import GitHubStars from "../GitHubStars.astro";
import VersionFlyout from "../VersionFlyout.astro";
---

<div class="kk-nav-right">
	<DefaultSocialIcons><slot /></DefaultSocialIcons>
	<GitHubStars />
	<VersionFlyout />
</div>

<style>
	/* The default component is a bare flex row; give the cluster room for
	   the extra pills and keep them stacked with the social icons. */
	.kk-nav-right {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
</style>
