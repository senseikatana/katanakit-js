---
/**
 * Slot override for `Hero`: release announcement above the default splash
 * hero, install command below its actions (the VitePress
 * `home-hero-info-before` / `home-hero-actions-after` slots). Only renders
 * on the splash page — Starlight only uses Hero for `template: splash`.
 */
import DefaultHero from "@astrojs/starlight/components/Hero.astro";

import HomeAnnouncement from "../HomeAnnouncement.astro";
import HeroInstall from "../HeroInstall.astro";
---

<div class="home-hero">
	<HomeAnnouncement />
	<DefaultHero><slot /></DefaultHero>
	<HeroInstall />
</div>
