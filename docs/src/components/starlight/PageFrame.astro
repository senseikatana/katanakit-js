---
/**
 * Slot override for `PageFrame`: the default frame plus the fixed
 * "What's new" changelog panel (the VitePress `layout-bottom` slot).
 */
import DefaultPageFrame from "@astrojs/starlight/components/PageFrame.astro";

import WhatNew from "../WhatNew.astro";
---

<DefaultPageFrame>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</DefaultPageFrame>
<WhatNew />
