---
/**
 * Slot override for `Head`: keeps Starlight's own head array (title,
 * canonical, description, og basics) and layers the docs site's SEO on top
 * through the library's own `useSeoMeta` — the same dogfooding the
 * VitePress `transformHead` hook did. Duplicates Starlight already owns
 * (title, canonical, viewport…) are dropped; Twitter cards layer on
 * afterwards because `useSeoMeta` only covers HTML + Open Graph.
 */
import { DOCS_KEYWORDS, DOCS_OG_IMAGE, DOCS_ORIGIN } from "../../seo";
import { useSeoMeta } from "../../../../src/config/seo.service";

const route = Astro.locals.starlightRoute;

/** Canonical URL for a page (`index.md` maps to the section root). */
function pageUrl(id: string): string {
	const clean = id.replace(/(^|\/)index$/, "$1").replace(/\/$/, "");
	return clean ? `${DOCS_ORIGIN}/${clean}` : `${DOCS_ORIGIN}/`;
}

const { tags } = useSeoMeta({
	title: route.entry.data.title,
	description: route.entry.data.description,
	keywords: DOCS_KEYWORDS,
	viewport: "width=device-width, initial-scale=1.0",
	canonical: pageUrl(route.entry.id),
	ogUrl: pageUrl(route.entry.id),
	ogType: "website",
});

/** Keys Starlight already rendered (meta name/property, link rel, title). */
const owned = new Set<string>();
for (const { tag, attrs } of route.head) {
	if (tag === "title") owned.add("title");
	else if (tag === "meta" && attrs?.name) owned.add(`meta:${attrs.name}`);
	else if (tag === "meta" && attrs?.property) owned.add(`meta:${attrs.property}`);
	else if (tag === "link" && attrs?.rel) owned.add(`link:${attrs.rel}`);
}

const keyOf = (tag: string, attrs?: Record<string, unknown>): string => {
	if (tag === "title") return "title";
	if (tag === "meta" && typeof attrs?.name === "string") return `meta:${attrs.name}`;
	if (tag === "meta" && typeof attrs?.property === "string") return `meta:${attrs.property}`;
	if (tag === "link" && typeof attrs?.rel === "string") return `link:${attrs.rel}`;
	return `${tag}:`;
};

const extra = tags.filter(({ tag, attrs }) => !owned.has(keyOf(tag, attrs)));

/** Starlight joins `title | site`; on the splash page both sides are equal. */
const head = route.head.map((item) => {
	if (item.tag !== "title" || !item.content) return item;
	const [pageTitle, siteTitle] = item.content.split(" | ");
	return pageTitle === siteTitle ? { ...item, content: pageTitle } : item;
});
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{extra.map(({ tag: Tag, attrs, text }) => <Tag {...attrs} set:html={text ?? ""} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={DOCS_OG_IMAGE} />
