---
interface Props {
	demo:
		| "button-variants"
		| "button-states"
		| "input-basic"
		| "input-errors"
		| "card-grid"
		| "badge-row"
		| "alert-stack"
		| "alert-dismissible";
	layout?: "row" | "stack" | "grid";
}

const { demo, layout = "row" } = Astro.props;
const className = `kk-demo-${layout}`;
---

<div class={className} data-kit-demo={demo}></div>

<script>
	import { useAlert, useBadge, useButton, useCard, useInput } from "@katanakit/ui";

	const samples: Record<string, (target: HTMLElement) => void> = {
		"button-variants": (target) =>
			target.append(
				useButton({ label: "Primary" }),
				useButton({ label: "Secondary", variant: "secondary" }),
				useButton({ label: "Ghost", variant: "ghost" }),
				useButton({ label: "Danger", variant: "danger" }),
			),
		"button-states": (target) =>
			target.append(
				useButton({ label: "Small", size: "sm" }),
				useButton({ label: "Medium" }),
				useButton({ label: "Large", size: "lg" }),
				useButton({ label: "Loading", loading: true }),
				useButton({ label: "Disabled", disabled: true }),
			),
		"input-basic": (target) =>
			target.append(
				useInput({
					label: "Email",
					type: "email",
					name: "email",
					placeholder: "you@example.com",
					help: "We only use it for receipts.",
				}).root,
				useInput({ label: "Password", type: "password", name: "password", value: "secret" })
					.root,
			),
		"input-errors": (target) =>
			target.append(
				useInput({
					label: "Email",
					type: "email",
					name: "email-error",
					value: "not-an-email",
					error: "Enter a valid email.",
				}).root,
			),
		"card-grid": (target) =>
			target.append(
				useCard({ title: "Revenue", children: ["$12,400"], footer: "Updated 5 min ago" }),
				useCard({ title: "Churn", children: ["2.1%"], elevated: true }),
				useCard({ title: "Open tickets", children: ["18"] }),
			),
		"badge-row": (target) =>
			target.append(
				useBadge({ label: "Draft" }),
				useBadge({ label: "Info", variant: "info" }),
				useBadge({ label: "Paid", variant: "success" }),
				useBadge({ label: "Pending", variant: "warning" }),
				useBadge({ label: "Failed", variant: "danger" }),
			),
		"alert-stack": (target) =>
			target.append(
				useAlert({ variant: "info", title: "Heads up", message: "Deploy starts in 10 minutes." }),
				useAlert({ variant: "success", message: "Backup finished." }),
				useAlert({ variant: "warning", message: "Quota at 90%." }),
				useAlert({ variant: "danger", title: "Build failed", message: "Check the logs." }),
			),
		"alert-dismissible": (target) =>
			target.append(
				useAlert({
					variant: "info",
					message: "This one can be dismissed.",
					dismissible: true,
				}),
			),
	};

	for (const element of document.querySelectorAll<HTMLElement>("[data-kit-demo]")) {
		const sample = element.dataset.kitDemo;
		if (sample && samples[sample]) samples[sample](element);
	}
</script>
