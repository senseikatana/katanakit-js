---
import { siteSignals } from "../signals";
import type { ChangelogRelease } from "../signals";

const CHANGELOG_URL = "/changelog";
/** Items shown per release — the panel is a summary, not the full changelog. */
const ITEMS_PER_RELEASE = 5;

const entry = siteSignals().changelog ?? null;

/** Last releases, each capped for the summary view. */
type ShownRelease = ChangelogRelease & { hidden: number };

const title = entry ? `Changelog ${formatDate(entry.date)}` : "";

const releases: ShownRelease[] = (entry?.releases ?? []).map((release) => {
	const items = release.items.slice(0, ITEMS_PER_RELEASE);
	const hidden = release.items.length - items.length;
	return { ...release, items, hidden };
});

function formatDate(iso: string): string {
	const [year, month, day] = iso.split("-").map(Number);
	const months = [
		"January", "February", "March", "April", "May", "June",
		"July", "August", "September", "October", "November", "December",
	];
	return `${months[(month ?? 1) - 1]} ${day}, ${year}`;
}

function shortDate(iso: string): string {
	const [, month, day] = iso.split("-").map(Number);
	const months = [
		"Jan", "Feb", "Mar", "Apr", "May", "Jun",
		"Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
	];
	return `${months[(month ?? 1) - 1]} ${day}`;
}
---

{
	entry && (
		<div class="whats-new" data-version={entry.version}>
			<button
				class="whats-new__launcher"
				type="button"
				aria-expanded="false"
				aria-controls="whats-new-panel"
			>
				<span class="whats-new__dot" aria-hidden="true" />
				v{entry.version}
				<span class="whats-new__label">What's new</span>
			</button>

			<section id="whats-new-panel" class="whats-new__panel" role="dialog" aria-label="Changelog" hidden>
				<header class="whats-new__header">
					<h2>{title}</h2>
					<button class="whats-new__close" type="button" aria-label="Close">
						✕
					</button>
				</header>

				<div class="whats-new__body">
					{releases.map((release) => (
						<section class="whats-new__release">
							<h3>
								v{release.version} <span>{shortDate(release.date)}</span>
							</h3>
							<ul>
								{release.items.map((item) => (
									<li>
										<span class="whats-new__emoji" aria-hidden="true">
											{item.emoji}
										</span>
										<span set:html={item.html} />
									</li>
								))}
								{release.hidden > 0 && (
									<li class="whats-new__more">… and {release.hidden} more</li>
								)}
							</ul>
						</section>
					))}
				</div>

				<footer class="whats-new__footer">
					<a class="whats-new__cta" href={CHANGELOG_URL}>
						See Full Changelog
					</a>
				</footer>
			</section>
		</div>
	)
}

<script>
	// Opens on first visit per release; the close button dismisses for good
	// (localStorage), and the launcher toggles the panel afterwards.
	const STORAGE_KEY = "katanakit:whats-new-seen";

	document.querySelectorAll<HTMLElement>(".whats-new").forEach((root) => {
		const launcher = root.querySelector<HTMLButtonElement>(".whats-new__launcher");
		const panel = root.querySelector<HTMLElement>(".whats-new__panel");
		const close = root.querySelector<HTMLButtonElement>(".whats-new__close");
		const version = root.dataset.version ?? "";
		if (!launcher || !panel) return;

		const setOpen = (open: boolean) => {
			launcher.setAttribute("aria-expanded", String(open));
			panel.hidden = !open;
			if (open) root.classList.add("open");
		};

		let seen: string | null = null;
		try {
			seen = localStorage.getItem(STORAGE_KEY);
		} catch {
			/* private mode — the panel simply shows again next visit */
		}
		// Open right away: the panel animates in through CSS, and a timer here
		// only adds a window where a route change can close it first.
		if (seen !== version) setOpen(true);

		launcher.addEventListener("click", () => {
			setOpen(launcher.getAttribute("aria-expanded") !== "true");
		});

		close?.addEventListener("click", () => {
			setOpen(false);
			try {
				localStorage.setItem(STORAGE_KEY, version);
			} catch {
				/* private mode — ignore */
			}
		});
	});
</script>
