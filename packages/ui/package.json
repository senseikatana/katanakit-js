{
	"name": "@katanakit/ui",
	"version": "0.0.0",
	"private": true,
	"description": "Katana UI foundations — framework-agnostic components styled with katanakit-css.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc6 -p tsconfig.json && sass src/styles/index.scss dist/styles.css --no-source-map --style=compressed --load-path=node_modules",
		"typecheck": "tsc6 -p tsconfig.json --noEmit"
	},
	"peerDependencies": {
		"katanakit-css": ">=0.12.5"
	},
	"peerDependenciesMeta": {
		"katanakit-css": {
			"optional": true
		}
	},
	"devDependencies": {
		"katanakit-css": "^0.12.5",
		"sass": "^1.104.0"
	}
}
