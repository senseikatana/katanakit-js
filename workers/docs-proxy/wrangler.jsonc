// Reverse-proxy Worker: mounts the katanakit-docs Pages project under /en/docs/
// on the apex domains that already serve other applications.
//
// Deploy: `npx wrangler deploy -c workers/docs-proxy/wrangler.jsonc`
//
// Routes are per-zone. The zones must exist in the same Cloudflare account.
// Add or remove domains here; the Worker code is domain-agnostic.
{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "katanakit-docs-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-01",

	// The Worker only fires on these routes; everything else stays with
	// whatever already serves the zone (the extranet app, samurai site, etc.).
	"routes": [
		// senseikatana.com is the docs/library domain — ONLY these routes live
		// here. Every other app on the account runs on samuraicoder.dev.
		{ "pattern": "senseikatana.com/", "zone_name": "senseikatana.com" },
		{ "pattern": "senseikatana.com/en", "zone_name": "senseikatana.com" },
		{ "pattern": "senseikatana.com/en/", "zone_name": "senseikatana.com" },
		{ "pattern": "senseikatana.com/en/docs", "zone_name": "senseikatana.com" },
		{ "pattern": "senseikatana.com/en/docs/*", "zone_name": "senseikatana.com" },
	],

	// No Service Binding: a Pages project is not a Workers service, so the
	// proxy fetches the public Pages URL. Cloudflare still routes that fetch
	// same-region, so the extra hop is a few milliseconds.
}